# Survey configuration shared by both receivers.
#
# Managed by `deck` (tools/deck.py) — change it from the menu, or edit by hand:
# one KEY=value per line, then restart the survey. Why each value is what it is
# lives in docs/wildfire.md and the git log, not here, so the menu can rewrite
# this file without losing anything.
RFSURVEY_PROFILE=profiles/festival.yaml
RFSURVEY_ENGINE=rust
RFSURVEY_DB=data/wildfire.sqlite
RFSURVEY_CAPTURE_DIR=data/captures/wildfire
RFSURVEY_CAPTURE_MB=40000
