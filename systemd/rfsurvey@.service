[Unit]
# One instance per receiver: rfsurvey@uhf, rfsurvey@vhf. The instance name is
# passed straight through as --receiver-id, so it must be one of the names in
# the profile's `receivers:` map, and it is what every logged row is attributed
# to. Getting it wrong is silent.
Description=RF survey deck — %i receiver
Documentation=file:/home/firestarss/rfsurvey/docs/handoff.md

# The deck runs unattended at a festival with no operator and often no network.
# Nothing here should wait on the network: it must start and keep logging
# whether or not WiFi ever associates.
After=local-fs.target

# Ordering only, deliberately not Requires=. The preflight check reports boot
# invariants (see systemd/rfsurvey-preflight); ordering after it guarantees its
# verdict is already in the journal above the survey's first output, so anyone
# reading back from a lockup sees the state of the machine before the data.
# Making it a hard dependency would let a failed check stop the survey, which is
# a deliberate choice documented in that unit and not the default.
After=rfsurvey-preflight.service

# Grouped under rfsurvey.target so both receivers start and stop as one unit.
# PartOf, not just WantedBy, because that is what makes `systemctl stop
# rfsurvey.target` propagate down to the instances.
PartOf=rfsurvey.target

# If it fails thirty times in half an hour it is not going to fix itself: the
# radio is unplugged, the profile is wrong, or the database is unwritable. Stop
# and leave it stopped rather than churning.
#
# Widened from 10-in-5-minutes on 2026-08-27, before the first genuinely
# unattended run. The old limit is right for a bench session where somebody is
# watching; over a multi-week deployment it is a trap, because one transient
# burst of USB re-enumeration on day two stops the survey permanently and the
# remaining weeks are lost. Thirty failures at RestartSec=10 is still five
# minutes of solid crash-looping before it gives up, which no transient does.
StartLimitIntervalSec=1800
StartLimitBurst=30

[Service]
Type=simple
User=firestarss
WorkingDirectory=/home/firestarss/rfsurvey

# Configuration, in order of precedence (later wins):
#   the defaults below
#   systemd/rfsurvey.env        shared by both receivers: profile, engine,
#                               database, capture directory and budget
#   systemd/rfsurvey-<rx>.env   per-receiver overrides, normally empty
# All three are read from the repository, so a change needs no reinstall — only
# a restart. `deck` (tools/deck.py) edits rfsurvey.env from a menu. The leading
# "-" means a missing file is not an error.
#
# Braced ${VAR} for single values so a path is never word-split; RFSURVEY_ARGS is
# unbraced on purpose so extra flags split into separate arguments.
Environment=RFSURVEY_PROFILE=profiles/festival.yaml
Environment=RFSURVEY_ENGINE=python
Environment=RFSURVEY_DB=data/survey.sqlite
Environment=RFSURVEY_CAPTURE_DIR=data/captures/default
Environment=RFSURVEY_CAPTURE_MB=2000
Environment=RFSURVEY_ARGS=
EnvironmentFile=-/home/firestarss/rfsurvey/systemd/rfsurvey.env
EnvironmentFile=-/home/firestarss/rfsurvey/systemd/rfsurvey-%i.env

ExecStart=/usr/bin/python3 src/survey_prototype.py \
    --receiver-id %i \
    --profile ${RFSURVEY_PROFILE} \
    --engine ${RFSURVEY_ENGINE} \
    --db ${RFSURVEY_DB} \
    --capture-dir ${RFSURVEY_CAPTURE_DIR} \
    --capture-mb ${RFSURVEY_CAPTURE_MB} \
    --stats $RFSURVEY_ARGS

# on-failure, deliberately, not always.
#
# The deck is not the only thing this machine is for, and the survey is something
# you start and stop rather than something that is simply always on. on-failure
# gives the two behaviours that matters:
#
#   crash, or a non-zero exit - restarted. survey_prototype exits non-zero when
#   the stream stops delivering samples, which is the case worth recovering: a
#   wedged USB endpoint does not come back in process, only re-enumeration fixes
#   it, and that needs a fresh start.
#
#   `systemctl stop`, or a clean exit - stays stopped. Restart=always would fight
#   you here, bringing the survey back up seconds after you deliberately ended it.
Restart=on-failure
RestartSec=10

# SIGINT, not SIGTERM: the capture loop installs a SIGINT handler that stops the
# loop cleanly, closes the in-flight events and the coverage window, and ends the
# run. SIGTERM would kill it mid-transaction and leave the last window open.
KillSignal=SIGINT
# 90 s, not 30. With --engine rust a stop sends "stop" to the engine, takes the
# close of the last window, then lets queued analyses finish; the orchestrator
# gives each of those up to 30 s. SIGKILL before that loses the final close.
TimeoutStopSec=90

# Journald keeps the console output. There is no other operator-visible log, and
# on a headless deck in a field this is the only way to find out what happened.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rfsurvey-%i

# The database and captures are the entire product of a deployment. Losing them
# to an OOM kill of the wrong process is not acceptable, so bias the killer away.
OOMScoreAdjust=-500

# Modest hardening. ProtectSystem=full leaves /home writable, which is where both
# the repository and the database live. PrivateDevices is deliberately NOT set —
# it would hide the USB radios, which is the whole point of the service.
NoNewPrivileges=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictRealtime=yes

# Deliberately NOT enabled by default - see systemd/README.md. Installing the
# unit only makes `systemctl start` available; nothing runs until you say so, and
# nothing starts at boot unless you explicitly `systemctl enable` it later.
[Install]
WantedBy=rfsurvey.target
