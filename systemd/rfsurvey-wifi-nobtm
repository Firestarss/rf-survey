#!/bin/bash
# Put disable_btm=1 into netplan's generated wpa_supplicant configuration.
#
# Why this exists: the home router sends 802.11v BSS Transition Management
# requests every 15-40 minutes. brcmfmac cannot send the response frame
# ("brcmf_p2p_send_action_frame: Unknown Frame: category 0xa, action 0x8"),
# wpa_supplicant tears the link down to act on the request anyway, and the Pi
# drops off the network. On 2026-09-16 that happened sixteen times across four
# boots, and once it came back associated with no DHCP lease for four minutes.
# See docs/deck-boot.md.
#
# disable_btm is a GLOBAL wpa_supplicant option, verified against the running
# daemon: `wpa_cli get disable_btm` answers, `get_network 0 disable_btm` FAILs.
# It stops the station advertising BSS Transition support in its association
# request, so a standards-compliant AP stops sending the requests. This build
# has no code path that ignores a request the AP sends regardless.
#
# Netplan cannot express it, and regenerates /run/netplan/wpa-wlan0.conf at
# every boot, so the edit has to be re-applied each time the supplicant starts.
# Run as ExecStartPre (and before reload) of netplan-wpa-wlan0.service.
#
# Never fails the unit: exits 0 on anything unexpected. A missing disable_btm
# costs the steering fix; a failed ExecStartPre would cost the WiFi.
set -u
CONF=${1:-/run/netplan/wpa-wlan0.conf}

if [ ! -f "$CONF" ]; then
    echo "rfsurvey-wifi-nobtm: $CONF not found; nothing to do" >&2
    exit 0
fi

if grep -q '^disable_btm=' "$CONF"; then
    sed -i 's/^disable_btm=.*/disable_btm=1/' "$CONF" || exit 0
elif grep -q '^network={' "$CONF"; then
    # Globals must precede the first network block.
    sed -i '0,/^network={/s//disable_btm=1\n\nnetwork={/' "$CONF" || exit 0
else
    printf '\ndisable_btm=1\n' >> "$CONF" || exit 0
fi

grep -q '^disable_btm=1$' "$CONF" \
    && echo "rfsurvey-wifi-nobtm: disable_btm=1 set in $CONF" \
    || echo "rfsurvey-wifi-nobtm: could not set disable_btm in $CONF" >&2
exit 0
