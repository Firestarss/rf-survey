[Unit]
# One network check. Acts only when associated but without an IPv4 address;
# silent when no network is in range, which is the normal state in the field.
# Activated once a minute by rfsurvey-netwatch.timer; see systemd/rfsurvey-netwatch.
Description=RF survey deck — network watchdog check
Documentation=file:/home/firestarss/rfsurvey/docs/deck-boot.md
After=network.target

[Service]
Type=oneshot
# Root: it restarts systemd-networkd and the supplicant. It never touches the
# survey and never reboots — a reboot costs a run boundary, and without an RTC
# battery a power cycle misdates the next run.
ExecStart=/home/firestarss/rfsurvey/systemd/rfsurvey-netwatch
SyslogIdentifier=rfsurvey-netwatch
